{
  "name": "yotsuba-kit-playground",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Vue and React consumer playground for local pre-release integration and npm registry verification of @iyotsuba/schedule-*.",
  "scripts": {
    "test": "vitest run",
    "dev:vue": "pnpm --filter vue-showcase dev",
    "dev:react": "pnpm --filter react-showcase dev",
    "build": "pnpm -r build"
  },
  "dependencies": {
    "@iyotsuba/schedule-core": "^0.7.1",
    "@iyotsuba/schedule-vue": "^0.7.1"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
