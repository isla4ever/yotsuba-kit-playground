{
  "name": "yotsuba-kit-playground",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Consumer-side playground & dependency tests for @iyotsuba/schedule-* — installs from the npm registry exactly like a real user.",
  "scripts": {
    "test": "vitest run",
    "dev:vue": "pnpm --filter vue-showcase dev",
    "dev:react": "pnpm --filter react-showcase dev",
    "build": "pnpm -r build"
  },
  "dependencies": {
    "@iyotsuba/schedule-core": "^0.4.0",
    "@iyotsuba/schedule-vue": "^0.4.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
